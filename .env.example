# Host paths resolve against the repository root. Do not use remote or in-memory databases.
NODE_ENV=development
PORT=3001
HOST=127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
LOG_LEVEL=info
API_PREFIX=/api/v1
DATABASE_FILE_PATH=./data/app.sqlite
# Bounded lock wait (0–30000ms); FULL synchronous durability.
DATABASE_BUSY_TIMEOUT_IN_MILLISECONDS=5000
TEST_DATABASE_DIRECTORY=./.test-data
VITE_API_BASE_URL=/api/v1
# Only the published static preview sets this to true. Full stack never falls back to demo storage.
VITE_DEMO_MODE=false
# Optional Web Push: pnpm push:keys ./push.env mailto:you@example.com
# Retain keys across releases; phones need the same reachable trusted HTTPS app origin.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:operator@example.com
# Docker: Node 24.19.0-bookworm-slim; nginx-unprivileged 1.28.2-alpine; UID/GID 1000.
FRONTEND_PORT=8080
PUBLIC_ORIGIN=http://localhost:8080
