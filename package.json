{
  "name": "folio-budget",
  "version": "1.15.1",
  "private": true,
  "type": "module",
  "engines": {
    "node": "24.19.x"
  },
  "packageManager": "pnpm@11.25.0",
  "scripts": {
    "dev": "concurrently --kill-others --names frontend,backend \"pnpm dev:frontend\" \"pnpm dev:backend\"",
    "dev:frontend": "vite --config frontend/vite.config.ts",
    "dev:backend": "node --watch --import tsx backend/src/server.ts",
    "db:generate": "drizzle-kit generate --config backend/drizzle.config.ts",
    "db:migrate": "node --import tsx backend/src/db/migrate.ts",
    "db:seed": "node --import tsx backend/src/db/seed.ts",
    "db:check": "node --import tsx backend/src/db/check.ts",
    "db:backup": "node --import tsx backend/src/db/backup.ts",
    "docker:config": "docker compose --profile app config --quiet",
    "docker:build": "docker compose --profile app build",
    "docker:migrate": "node --import tsx scripts/dockerMigrate.ts",
    "docker:up": "node --import tsx scripts/dockerUp.ts",
    "docker:down": "docker compose --profile app down",
    "docker:logs": "docker compose --profile app logs --follow",
    "pwa:icons": "node --import tsx scripts/generateIcons.ts",
    "build": "pnpm build:frontend && pnpm build:backend && node scripts/packageStatic.mjs",
    "build:frontend": "tsc -p frontend/tsconfig.json && node scripts/cleanFrontend.mjs && vite build --config frontend/vite.config.ts",
    "build:backend": "tsc -p backend/tsconfig.json && node --import tsx scripts/copyMigrations.ts",
    "preview": "vite preview --config frontend/vite.config.ts",
    "start": "node backend/dist/server.js",
    "lint": "oxlint --deny-warnings .",
    "typecheck": "tsc --noEmit -p frontend/tsconfig.json && tsc --noEmit -p backend/tsconfig.json && tsc --noEmit -p frontend/tsconfig.worker.json",
    "test": "vitest",
    "test:run": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:demo": "node scripts/buildDemo.mjs",
    "verify:build": "node scripts/verifyBuild.mjs",
    "push:keys": "node --import tsx backend/src/features/reminders/generatePushKeys.ts"
  },
  "dependencies": {
    "better-sqlite3": "13.0.3",
    "cors": "2.8.6",
    "dotenv": "18.0.8",
    "drizzle-orm": "0.45.4",
    "express": "5.3.0",
    "helmet": "8.3.0",
    "pino": "10.4.0",
    "pino-http": "11.0.0",
    "web-push": "3.6.7",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "7.0.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/better-sqlite3": "9.6.0",
    "@types/cors": "2.8.19",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/sql.js": "1.4.11",
    "@types/supertest": "7.2.1",
    "@types/web-push": "3.6.4",
    "@vite-pwa/assets-generator": "2.0.0",
    "@vitejs/plugin-react": "6.1.2",
    "concurrently": "10.0.6",
    "drizzle-kit": "0.31.11",
    "fflate": "0.8.3",
    "jsdom": "30.1.3",
    "lucide-react": "1.57.0",
    "oxlint": "1.88.0",
    "prettier": "3.9.10",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-router-dom": "7.18.4",
    "sharp": "0.35.5",
    "sql.js": "1.15.0",
    "supertest": "7.3.1",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "uuid": "14.0.3",
    "vite": "8.3.4",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.0.4",
    "workbox-expiration": "7.4.1",
    "workbox-precaching": "7.4.1",
    "workbox-routing": "7.4.1",
    "workbox-strategies": "7.4.1",
    "workbox-window": "7.4.1"
  }
}
