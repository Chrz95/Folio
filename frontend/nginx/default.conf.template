# Cache policy is inherited without overriding the security headers inside locations.
map $uri $static_cache_policy {
 default "no-cache";
 ~^/assets/ "public, max-age=${ASSET_MAX_AGE}, immutable";
 ~^/api/ "no-store";
}
server {
 listen ${NGINX_PORT};
 server_tokens off;
 client_max_body_size 16m;
 root /usr/share/nginx/html;
 index index.html;
 gzip on;
 gzip_types text/css application/javascript application/json image/svg+xml;
 add_header Cache-Control $static_cache_policy always;
 add_header X-Content-Type-Options nosniff always;
 add_header Referrer-Policy strict-origin-when-cross-origin always;
 add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self'; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; frame-ancestors 'none'" always;
 location /api/v1/ {
  proxy_pass ${BACKEND_ORIGIN};
  proxy_set_header Host $host;
  proxy_set_header X-Forwarded-Proto $scheme;
  proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
  proxy_set_header X-Request-Id $request_id;
  proxy_read_timeout ${PROXY_TIMEOUT};
  proxy_connect_timeout ${PROXY_TIMEOUT};
 }
 location = /sw.js { try_files $uri =404; }
 location = /manifest.webmanifest { default_type application/manifest+json; try_files $uri =404; }
 location = /index.html { }
 location ~* ^/assets/ { try_files $uri =404; }
 location ~ /[^/]+\.[^/]+$ { try_files $uri =404; }
 location / {
  if ($http_accept !~* 'text/html') { return 404; }
  try_files $uri $uri/ /index.html;
 }
}
